BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Use MONGO_URI (or MONGODB_URI — both work)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=word_duel

WORD_LENGTH=5
MAX_ROUNDS=10

# Render sets PORT and RENDER_EXTERNAL_URL automatically.
# For local webhook testing, set WEBHOOK_URL to a public https URL (ngrok).
# PORT=8080
# WEBHOOK_URL=https://your-service.onrender.com
# WEBHOOK_PATH=/telegram
# WEBHOOK_SECRET=long-random-string
# HEALTH_PATH=/health

# Optional — only if Telegram is blocked on your network (local polling)
# TELEGRAM_PROXY=http://127.0.0.1:7890
# TELEGRAM_TIMEOUT=30
