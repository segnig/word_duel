BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Use MONGO_URI (or MONGODB_URI — both work)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=word_duel

WORD_LENGTH=5
MAX_ROUNDS=10

# Optional — only if Telegram is blocked on your network (local dev)
# Common Clash/V2Ray: TELEGRAM_PROXY=http://127.0.0.1:7890
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
# TELEGRAM_TIMEOUT=30
